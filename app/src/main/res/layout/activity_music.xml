<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#1A1A1A"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Botón MODO MÚSICA -->
    <Button
        android:id="@+id/btnModeMusic"
        android:layout_width="40dp"
        android:layout_height="120dp"
        android:text="M"
        android:backgroundTint="#00AAFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnModeRecord"/>

    <!-- Botón MODO RECORD -->
    <Button
        android:id="@+id/btnModeRecord"
        android:layout_width="40dp"
        android:layout_height="120dp"
        android:text="R"
        android:backgroundTint="#444444"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnModeMusic"/>

    <!-- CASSETTE SIMULADO -->
    <com.example.walkmanapp.CassetteView
        android:id="@+id/cassetteView"
        android:background="@drawable/bg_walkman_body"
        android:layout_width="0dp"
        android:layout_height="220dp"
        android:layout_margin="16dp"
        app:layout_constraintEnd_toStartOf="@id/btnModeMusic"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Título -->
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="mm_intro.mp3"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/cassetteView"
        app:layout_constraintStart_toStartOf="@id/cassetteView"
        app:layout_constraintEnd_toEndOf="@id/cassetteView"/>

    <!-- Seekbar -->
    <SeekBar
        android:id="@+id/seekBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/txtTitle"
        app:layout_constraintStart_toStartOf="@id/txtTitle"
        app:layout_constraintEnd_toEndOf="@id/txtTitle"/>

    <!-- Tiempos -->
    <LinearLayout
        android:id="@+id/layoutTime"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/seekBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtCurrentTime"
            android:text="00:00"
            android:textColor="#FFFFFF"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/txtSlash"
            android:text="/"
            android:textColor="#FFFFFF"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/txtDuration"
            android:text="00:00"
            android:textColor="#FFFFFF"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- Controles -->

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/bg_circle"
            android:src="@android:drawable/ic_media_rew"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/layoutTime"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnPlayMusic"/>

        <ImageButton
            android:id="@+id/btnPlayMusic"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/walkman_yellow"
            android:src="@android:drawable/ic_media_play"
            app:layout_constraintTop_toTopOf="@id/btnBack"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintEnd_toStartOf="@id/btnForward"/>

        <ImageButton
            android:id="@+id/btnForward"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/bg_circle"
            android:src="@android:drawable/ic_media_ff"
            app:layout_constraintTop_toTopOf="@id/btnPlayMusic"
            app:layout_constraintStart_toEndOf="@id/btnPlayMusic"
            app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>