<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#111111"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Botón MODO MÚSICA -->
    <Button
        android:id="@+id/btnModeMusic"
        android:layout_width="40dp"
        android:layout_height="120dp"
        android:text="M"
        android:backgroundTint="#00AAFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnModeRecord"/>

    <!-- Botón MODO RECORD -->
    <Button
        android:id="@+id/btnModeRecord"
        android:layout_width="40dp"
        android:layout_height="120dp"
        android:text="R"
        android:backgroundTint="#444444"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnModeMusic"/>

    <!-- Botón grabar -->
    <ImageButton
        android:id="@+id/btnRecord"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="@drawable/bg_circle"
        android:src="@android:drawable/ic_btn_speak_now"
        android:layout_marginTop="250dp"
        app:tint="#FF4444"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnPlayRecord"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Play -->
    <ImageButton
        android:id="@+id/btnPlayRecord"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="@drawable/bg_circle"
        android:src="@android:drawable/ic_media_play"
        app:tint="#00FFAA"
        app:layout_constraintTop_toTopOf="@+id/btnRecord"
        app:layout_constraintStart_toEndOf="@id/btnRecord"
        app:layout_constraintEnd_toStartOf="@id/btnSave"/>

    <!-- Save -->
    <ImageButton
        android:id="@+id/btnSave"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="@drawable/bg_circle"
        android:src="@android:drawable/ic_menu_save"
        app:tint="#FFFFFF"
        app:layout_constraintTop_toTopOf="@+id/btnPlayRecord"
        app:layout_constraintStart_toEndOf="@id/btnPlayRecord"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Switch
        android:id="@+id/swReverse"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Invertir audio"
        android:textColor="#FFFFFF"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/btnSave"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Texto -->
    <TextView
        android:id="@+id/txtRecording"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="● Grabando..."
        android:textColor="#FF4444"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/swReverse"
        app:layout_constraintStart_toStartOf="@id/swReverse"
        app:layout_constraintEnd_toEndOf="@id/swReverse"/>

    <SeekBar
        android:id="@+id/seekBarRecord"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/txtRecording"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:id="@+id/layoutTimeRecord"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/seekBarRecord"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtCurrentTimeRecord"
            android:text="00:00"
            android:textColor="#FFFFFF"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:text=" / "
            android:textColor="#FFFFFF"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/txtDurationRecord"
            android:text="00:00"
            android:textColor="#FFFFFF"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/waveScroll"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:layout_marginTop="20dp"
        android:fillViewport="false"
        app:layout_constraintTop_toBottomOf="@id/layoutTimeRecord"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.example.walkmanapp.WaveformView
            android:id="@+id/waveformView"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"/>
    </HorizontalScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>