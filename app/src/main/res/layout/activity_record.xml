<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#1A1A1A"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="60dp" > <!-- Espacio al final del scroll -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- CASSETTE SIMULADO -->
        <com.example.walkmanapp.views.CassetteView
            android:id="@+id/cassetteView"
            android:background="@drawable/bg_walkman_body"
            android:layout_width="300dp"
            android:layout_height="500dp"
            android:layout_margin="16dp"
            android:elevation="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <!-- Botón MODO MÚSICA -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnModeMusic"
            android:layout_width="30dp"
            android:layout_height="120dp"
            android:background="@drawable/bg_side_button"
            android:layout_marginTop="40dp"
            android:layout_marginStart="-6dp"
            app:layout_constraintStart_toEndOf="@id/cassetteView"
            app:layout_constraintTop_toTopOf="parent"
            />

        <!-- Botón MODO RECORD -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnModeRecord"
            android:layout_width="36dp"
            android:layout_height="120dp"
            android:background="@drawable/bg_side_button"
            android:layout_marginTop="2dp"
            android:backgroundTint="@null"
            android:layout_marginStart="-6dp"
            app:layout_constraintStart_toEndOf="@id/cassetteView"
            app:layout_constraintTop_toBottomOf="@id/btnModeMusic"/>

        <!-- Botón grabar -->
        <ImageButton
            android:id="@+id/btnRecord"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_circle"
            android:src="@android:drawable/ic_btn_speak_now"
            android:layout_marginTop="20dp"
            app:tint="#FF4444"
            app:layout_constraintTop_toBottomOf="@id/cassetteView"
            app:layout_constraintEnd_toStartOf="@id/btnPlayRecord"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Play -->
        <ImageButton
            android:id="@+id/btnPlayRecord"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_circle"
            android:src="@android:drawable/ic_media_play"
            app:tint="#00FFAA"
            app:layout_constraintTop_toTopOf="@+id/btnRecord"
            app:layout_constraintStart_toEndOf="@id/btnRecord"
            app:layout_constraintEnd_toStartOf="@id/btnSave"/>

        <!-- Save -->
        <ImageButton
            android:id="@+id/btnSave"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_circle"
            android:src="@android:drawable/ic_menu_save"
            app:tint="#FFFFFF"
            app:layout_constraintTop_toTopOf="@+id/btnPlayRecord"
            app:layout_constraintStart_toEndOf="@id/btnPlayRecord"
            app:layout_constraintEnd_toEndOf="parent"/>

        <Switch
            android:id="@+id/swReverse"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Invertir audio"
            android:textColor="#FFFFFF"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/btnSave"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Texto -->
        <TextView
            android:id="@+id/txtRecording"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● Grabando..."
            android:textColor="#FF4444"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/swReverse"
            app:layout_constraintStart_toStartOf="@id/swReverse"
            app:layout_constraintEnd_toEndOf="@id/swReverse"/>

        <SeekBar
            android:id="@+id/seekBarRecord"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/txtRecording"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <LinearLayout
            android:id="@+id/layoutTimeRecord"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/seekBarRecord"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/txtCurrentTimeRecord"
                android:text="00:00"
                android:textColor="#FFFFFF"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:text=" / "
                android:textColor="#FFFFFF"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/txtDurationRecord"
                android:text="00:00"
                android:textColor="#FFFFFF"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/waveScroll"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_marginTop="20dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:fillViewport="false"
            app:layout_constraintTop_toBottomOf="@id/layoutTimeRecord"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.example.walkmanapp.views.WaveformView
                android:id="@+id/waveformView"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"/>
        </HorizontalScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>