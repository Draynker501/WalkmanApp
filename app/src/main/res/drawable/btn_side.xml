<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- PRESIONADO -->
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#888888"/>
            <corners android:radius="2dp"/>
        </shape>
    </item>

    <!-- NORMAL -->
    <item>
        <shape>
            <solid android:color="#E5E5E5"/>
            <corners android:radius="6dp"/>
        </shape>
    </item>

</selector>