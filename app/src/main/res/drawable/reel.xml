<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base del círculo -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:startColor="#E5E5E5"
                android:endColor="#A0A0A0"
                android:angle="45"/>
        </shape>
    </item>

    <!-- Centro del reel -->
    <item
        android:width="20dp"
        android:height="20dp"
        android:gravity="center">

        <shape android:shape="oval">
            <solid android:color="#555555"/>
        </shape>
    </item>

</layer-list>